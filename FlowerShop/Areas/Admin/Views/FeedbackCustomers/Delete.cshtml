@model FlowerShop.Models.FeedbackCustomer

@{
    ViewData["Title"] = "Delete";
    Layout = "~/Areas/Admin/Views/Shared/_Layout.cshtml";
}

<div class="content-wrapper">
    <!-- Content Header (Page header) -->
    <section class="content-header">
        <div class="container-fluid">
            <div class="row mb-2">
                <div class="col-sm-6">
                    <h1>Xóa BL</h1>
                </div>
                <div class="col-sm-6">
                    <ol class="breadcrumb float-sm-right">
                        <li class="breadcrumb-item"><a href="#">Home</a></li>
                        <li class="breadcrumb-item active">General Form</li>
                    </ol>
                </div>
            </div>
        </div><!-- /.container-fluid -->
    </section>

    <!-- Main content -->
    <section class="content">
        <div class="container-fluid">
            <div class="row">
                <!-- left column -->
                <div class="col-md">
                    <!-- general form elements -->
                    <div class="card card-primary">
                        <div class="card-header">
                            <h3 class="card-title">Xóa BL</h3>
                        </div>
                        <div class="card-body">
                            <div class="form-group">
                                <label for="exempleInputEmail1">Bình luận:</label>
                                @Html.DisplayFor(model => model.Content)
                            </div>

                            <div class="form-group">
                                <label for="exempleInputPassword1">Avata:</label>

                                <div class="mt-2">
                                    <img src="@Model.AvatarUrl"
                                         style="max-width:200px; max-height:200px; border:1px solid #ccc;" />
                                </div>
                            </div>
                            <div class="form-group">
                                <label for="exempleInputPassword1">Sao:</label>
                                @Html.DisplayFor(model => model.Star)
                            </div>
                            <div class="form-group">
                                <label for="exempleInputPassword1">Tên sản phẩm:</label>
                                @Html.DisplayFor(model => model.Product.ProductName)

                            </div>
                            <div class="form-group">
                                <label for="exempleInputPassword1">Tên khách hàng:</label>
                                @Html.DisplayFor(model => model.Ten)

                            </div>

                            <div class="form-group">
                                <label for="exempleInputPassword1">Email:</label>
                                @Html.DisplayFor(model => model.Email)
                            </div>


                            <div class="form-group">
                                <label for="exempleInputPassword1">Hiển thị:</label>
                                @Html.DisplayFor(model => model.IsActive)
                                <form asp-action="Delete">
                                    <input type="hidden" asp-for="FeedbackCustomerId" />
                                    <input type="submit" value="Xóa" class="btn btn-danger" />
                                    <a asp-action="Index" class="btn btn-primary">Quay lại</a>
                                </form>
                            </div>
                        </div>



                    </div>



                </div>


            </div>

        </div>
        <!-- /.row -->
        <!-- /.container-fluid -->

    </section>
    <!-- /.content -->
</div>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }

}

