@model FlowerShop.Models.FeedbackCustomer

@{
    ViewData["Title"] = "Create";
    Layout = "~/Areas/Admin/Views/Shared/_Layout.cshtml";
}

<div class="content-wrapper">
    <!-- Content Header (Page header) -->
    <section class="content-header">
        <div class="container-fluid">
            <div class="row mb-2">
                <div class="col-sm-6">
                    <h1>Thêm BL </h1>
                </div>
                <div class="col-sm-6">
                    <ol class="breadcrumb float-sm-right">
                        <li class="breadcrumb-item"><a href="#">Home</a></li>
                        <li class="breadcrumb-item active">General Form</li>
                    </ol>
                </div>
            </div>
        </div><!-- /.container-fluid -->
    </section>

    <!-- Main content -->
    <section class="content">
        <div class="container-fluid">
            <div class="row">
                <!-- left column -->
                <div class="col-md">
                    <!-- general form elements -->
                    <div class="card card-primary">
                        <div class="card-header">
                            <h3 class="card-title">Thêm BL </h3>
                        </div>
                        <div asp-validation-summary="All" class="text-danger"></div>
                        <!-- /.card-header -->
                        <!-- form start -->
                        <!--thêm cái này ở enctype="multipart/form-data ở sau Create khi thêm ảnh -->
                        <form asp-action="Create">

                            <div class="card-body">
                                <div asp-validation-summary="ModelOnly" class="text-danger"></div>
                                <div class="form-group">
                                    <label asp-for="Content" class="control-label">Bình luận:</label>
                                    <input asp-for="Content" class="form-control" />
                                    <span asp-validation-for="Content" class="text-danger"></span>
                                </div>

                                <div class="form-group">
                                    <label asp-for="AvatarUrl" class="control-label">Avata:</label>
                                    <div class="input-group mb-3">
                                        <div class="input-group-prepend">
                                            <button type="button" class="btn btn-success" onclick="openDialog()">Choose a picture</button>
                                        </div>

                                        <input type="text" class="form-control" id="file_input" asp-for="AvatarUrl" aria-describedby="button-addon2" />

                                    </div>
                                    <span asp-validation-for="AvatarUrl" class="text-danger"></span>

                                </div>

                                <div class="form-group">
                                    <label asp-for="Star" class="control-label">Sao:</label>
                                    <input asp-for="Star" class="form-control" />
                                    <span asp-validation-for="Star" class="text-danger"></span>
                                </div>

                                <div class="form-group form-check">
                                    <label class="form-check-label">
                                        <input class="form-check-input" asp-for="IsActive" /> Hiển thị
                                    </label>
                                </div>

                                <div class="form-group">
                                    <label asp-for="ProductId" class="control-label">Tên sản phẩm:</label>
                                    <select asp-for="ProductId" class="form-control" asp-items="ViewBag.ProductId">
                                        <option value="0" selected>--[Chọn tên]--</option>
                                    </select>
                                </div>
                                <div class="form-group">
                                    <label asp-for="Ten" class="control-label">Tên khách hàng:</label>
                                    <input asp-for="Ten" class="form-control" />
                                    <span asp-validation-for="Ten" class="text-danger"></span>
                                </div>


                                <div class="form-group">
                                    <label asp-for="Email" class="control-label">Email: </label>
                                    <input asp-for="Email" class="form-control" />
                                    <span asp-validation-for="Email" class="text-danger"></span>
                                </div>



                                <div class="form-group">
                                    <input type="submit" value="Thêm mới" class="btn btn-primary" />
                                </div>
                            </div>
                        </form>

                    </div>


                </div>

            </div>
            <!-- /.row -->
        </div><!-- /.container-fluid -->
    </section>
    <!-- /.content -->

</div>

@{
    var summerNote = new FlowerShop.Areas.Admin.Models.SummerNote("#ProductDescription");
    <partial name="_SummerNote" model="summerNote" />
}

<!--Phải có scrip này nhé lưu ý ở trang layout phải có-->
@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }

}