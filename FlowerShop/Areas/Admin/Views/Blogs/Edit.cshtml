@model FlowerShop.Models.Blog

@{
    ViewData["Title"] = "Edit";
    Layout = "~/Areas/Admin/Views/Shared/_Layout.cshtml";
}

<div class="content-wrapper">
    <!-- Content Header (Page header) -->
    <section class="content-header">
        <div class="container-fluid">
            <div class="row mb-2">
                <div class="col-sm-6">
                    <h1>Sửa sản phẩm</h1>
                </div>
                <div class="col-sm-6">
                    <ol class="breadcrumb float-sm-right">
                        <li class="breadcrumb-item"><a href="#">Home</a></li>
                        <li class="breadcrumb-item active">General Form</li>
                    </ol>
                </div>
            </div>
        </div><!-- /.container-fluid -->
    </section>

    <!-- Main content -->
    <section class="content">
        <div class="container-fluid">
            <div class="row">
                <!-- left column -->
                <div class="col-md">
                    <!-- general form elements -->
                    <div class="card card-primary">
                        <div class="card-header">
                            <h3 class="card-title">Sửa SP</h3>
                        </div>
                        <!-- /.card-header -->
                        <!-- form start -->

                        <form asp-action="Edit">
                            <input type="hidden" asp-for="BlogId" />
                            <div class="card-body">
                                <div asp-validation-summary="ModelOnly" class="text-danger"></div>
                                <div class="form-group">
                                    <label asp-for="Title" class="control-label">bài viết:</label>
                                    <input asp-for="Title" class="form-control" />
                                    <span asp-validation-for="Title" class="text-danger"></span>
                                </div>
                                <div class="form-group">
                                    <label asp-for="ProductCategoryId" class="control-label">Danh mục:</label>
                                    <select asp-for="ProductCategoryId" class="form-control" asp-items="ViewBag.ProductCategoryId">
                                        <option value="0" selected>--[Chọn danh mục]--</option>
                                    </select>
                                </div>
                                <div class="form-group">
                                    <label asp-for="UserId" class="control-label">Khách hàng:</label>
                                    <select asp-for="UserId" class="form-control" asp-items="ViewBag.UserId">
                                        <option value="0" selected>--[Tên khách hàng]--</option>
                                    </select>
                                </div>

                                <div class="form-group">
                                    <label asp-for="Summary" class="control-label">Tóm tắt: </label>
                                    <textarea asp-for="Summary" class="form-control"></textarea>
                                    <span asp-validation-for="Summary" class="text-danger"></span>
                                </div>
                                <div class="form-group">
                                    <label asp-for="Content" class="control-label">Bình luận:</label>
                                    <input asp-for="Content" class="form-control" />
                                    <span asp-validation-for="Content" class="text-danger"></span>
                                </div>
                                <div class="form-group">
                                    <label asp-for="CreatedBlog" class="control-label">Ngày:</label>
                                    <input asp-for="CreatedBlog" class="form-control" />
                                    <span asp-validation-for="CreatedBlog" class="text-danger"></span>
                                </div>
                                <div class="form-group">
                                    <label asp-for="Alias" class="control-label">Bí danh:</label>
                                    <input asp-for="Alias" class="form-control" />

                                    <span asp-validation-for="Alias" class="text-danger"></span>
                                </div>


                                <div class="form-group">
                                    <label asp-for="Image" class="control-label">Ảnh:</label>
                                    <div class="input-group mb-3">
                                        <div class="input-group-prepend">
                                            <button type="button" class="btn btn-success" onclick="openDialog()">Choose a picture</button>
                                        </div>

                                        <input type="text" class="form-control" id="file_input" asp-for="Image" aria-describedby="button-addon2" />

                                    </div>
                                    <span asp-validation-for="Image" class="text-danger"></span>

                                </div>

                                <div class="form-group form-check">
                                    <label class="form-check-label">
                                        <input class="form-check-input" asp-for="IsActive" /> Hiển thị:
                                    </label>
                                </div>

                                <div class="form-group">
                                    <label asp-for="AuthorName" class="control-label">Tác giả:</label>
                                    <textarea asp-for="AuthorName" class="form-control"></textarea>
                                    <span asp-validation-for="AuthorName" class="text-danger"></span>
                                </div>
                                <div class="form-group">
                                    <input type="submit" value="Sửa" class="btn btn-primary" />
                                </div>
                            </div>
                        </form>

                    </div>


                </div>

            </div>
            <!-- /.row -->
        </div><!-- /.container-fluid -->
    </section>
    <!-- /.content -->
</div>
@{
    var summerNote = new FlowerShop.Areas.Admin.Models.SummerNote("#Summary");
    <partial name="_SummerNote" model="summerNote" />
}


@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }


}






