@model IEnumerable<FlowerShop.Models.Blog>

@{
    ViewData["Title"] = "Index";
    Layout = "~/Areas/Admin/Views/Shared/_Layout.cshtml";
}

<div class="content-wrapper">
    <!-- Content Header (Page header) -->
    <section class="content-header">
        <div class="container-fluid">
            <div class="row mb-2">
                <div class="col-sm-6">
                    <h1>Quản lý Blog </h1>
                </div>
                <div class="col-sm-6">
                    <ol class="breadcrumb float-sm-right">
                        <li class="breadcrumb-item"><a href="#">Home</a></li>
                        <li class="breadcrumb-item active">Simple Tables</li>
                    </ol>
                </div>
            </div>
        </div><!-- /.container-fluid -->
    </section>

    <!-- Main content -->
    <section class="content">
        <div class="container-fluid">

            <!-- /.row -->
            <div class="row">
                <div class="col-12">
                    <div class="card">
                        <div class="card-header">
                            <h3 class="card-title"><a asp-action="Create">Thêm mới</a></h3>

                            <div class="card-tools">
                                <div class="input-group input-group-sm" style="width: 150px;">
                                    <input type="text" name="table_search" class="form-control float-right" placeholder="Search">

                                    <div class="input-group-append">
                                        <button type="submit" class="btn btn-default">
                                            <i class="fas fa-search"></i>
                                        </button>
                                    </div>
                                </div>
                            </div>
                        </div>
                        <!-- /.card-header -->
                        <div class="card-body table-responsive p-0">
                            <table class="table table-hover text-nowrap">
                                <thead>
                                    <tr>
                                        <th>STT:</th>
                                        <th>Bài viết:</th>
                                        <th>Danh mục:</th>
                                        <th>Khách hàng:</th>
                                        <th>Bản tóm tắt:</th>
                                        <th>Bình luận:</th>
                                        <th>Ngày:</th>
                                        <th>Bí danh:</th>
                                        <th>Ảnh:</th>
                                        <th>hiển thị:</th>
                                        <th>Tác giả:</th>

                                    </tr>
                                </thead>
                                <tbody>
                                    @{
                                        int i = 1;
                                    }
                                    @foreach (var item in Model)
                                    {
                                        <tr>
                                            <td>@(i++)</td>
                                            <td>@Html.DisplayFor(modelItem => item.Title)</td>
                                            <td>@Html.DisplayFor(modelItem => item.ProductCategory.ProductCategoryName)</td>
                                            <td>@Html.DisplayFor(modelItem => item.User.FullName)</td>
                                            <td>@Html.DisplayFor(modelItem => item.Summary)</td>
                                            <td>@Html.DisplayFor(modelItem => item.Content)</td>
                                            <td>@Html.DisplayFor(modelItem => item.CreatedBlog)</td>
                                            <td>@Html.DisplayFor(modelItem => item.Alias)</td>
                                            <td><img src="@Html.Raw(item.Image)" alt="@item.Title" width="50" height="50" /></td>
                                            <td>@Html.DisplayFor(modelItem => item.IsActive)</td>
                                            <td>@Html.DisplayFor(modelItem => item.AuthorName)</td>
                                            <td>
                                                <a asp-action="Edit" asp-route-id="@item.BlogId" class="btn btn-primary">Sửa</a>

                                                <a asp-action="Delete" asp-route-id="@item.BlogId" class=" btn btn-danger">Xóa</a>
                                            </td>
                                        </tr>
                                    }


                                </tbody>
                            </table>
                        </div>
                        <!-- /.card-body -->
                    </div>
                    <!-- /.card -->
                </div>
            </div>

            <!-- /.row -->
        </div><!-- /.container-fluid -->
    </section>
    <!-- /.content -->
</div>