<style>
    /* CSS để làm đẹp giao diện Admin */
    .content-wrapper {
        background-color: #f4f6f9;
        padding-bottom: 30px;
    }
    .card {
        border: none;
        transition: transform 0.2s;
    }
    .card:hover {
        transform: translateY(-5px);
    }
    .product-actions {
        opacity: 0;
        transition: opacity 0.3s;
    }
    .product-image-container:hover .product-actions {
        opacity: 1;
    }
</style>