@model IEnumerable<FlowerShop.Models.Product>

@{
    ViewData["Title"] = "Index";
    Layout = "~/Areas/Admin/Views/Shared/_Layout.cshtml";
}

<div class="content-wrapper">
    <!-- Content Header (Page header) -->
    <section class="content-header">
        <div class="container-fluid">
            <div class="row mb-2">
                <div class="col-sm-6">
                    <h1>Quản lý sản phẩm </h1>
                </div>
               
            </div>
        </div><!-- /.container-fluid -->
    </section>

    <!-- Main content -->
    <section class="content">
        <div class="container-fluid">

            <!-- /.row -->
            <div class="row">
                <div class="col-12">
                    <div class="card">
                        <div class="card-header">
                            <h3 class="card-title"><a asp-action="Create">Thêm mới</a></h3>

                            <div class="card-tools">
                                <form asp-action="Index" method="get">
                                    <div class="input-group input-group-sm" style="width: 250px;">
                                        <input type="text" name="q" value="@ViewContext.HttpContext.Request.Query["q"]"
                                               class="form-control float-right" placeholder="Tìm tên sản phẩm...">

                                        <div class="input-group-append">
                                            <button type="submit" class="btn btn-default">
                                                <i class="fas fa-search"></i>
                                            </button>
                                            @if (!string.IsNullOrEmpty(ViewContext.HttpContext.Request.Query["q"]))
                                            {
                                                <a asp-action="Index" class="btn btn-default" title="Hủy tìm kiếm">
                                                    <i class="fas fa-times"></i>
                                                </a>
                                            }
                                        </div>
                                    </div>
                                </form>
                                @* <div class="input-group input-group-sm" style="width: 150px;">
                                    <input type="text" name="table_search" class="form-control float-right" placeholder="Search">

                                    <div class="input-group-append">
                                        <button type="submit" class="btn btn-default">
                                            <i class="fas fa-search"></i>
                                        </button>
                                    </div>
                                </div> *@
                            </div>
                        </div>
                        <!-- /.card-header -->
                        <div class="card-body table-responsive p-0">
                            <table class="table table-hover text-nowrap">
                                <thead>
                                    <tr>
                                        <th>Ảnh:</th>
                                        <th>STT:</th>
                                        <th>Tên sản phẩm:</th>
                                        <th>Danh mục:</th>
                                        <th>Đường dẫn:</th>
                                      
                                        <th>Giá sản phẩm:</th>
                                        <th>Giá  sản phẩm sau giảm:</th>
                                        <th>Giá giảm:</th>
                                        <th>Số lượng:</th>
                                        
                                        <th>Nhà cung cấp:</th>
                                        <th>Sản phẩm mới:</th>
                                        <th>Bán chạy:</th>
                                        <th>Sao:</th>
                                        <th>Trạng thái:</th>
                                         <th>Loại vật liệu:</th>
                                        <th>Vật liệu bán lẻ:</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    @{
                                        int i = 1;
                                    }
                                    @foreach (var item in Model)
                                    {
                                        <tr>
                                            
                                            <td><img src="@Html.Raw(item.ImagePopular)" alt="@item.ProductName" width="50" height="50" /></td>
                                            <td>@(i++)</td>
                                            <td>@Html.DisplayFor(modelItem => item.ProductName)</td>
                                            <td>@Html.DisplayFor(modelItem => item.ProductCategory.ProductCategoryName)</td>
                                            <td>@Html.DisplayFor(modelItem => item.Alias)</td>

                                           
                                            <td>@Html.DisplayFor(modelItem => item.ProductPrice)</td>
                                            <td>@Html.DisplayFor(modelItem => item.DiscountPrice)</td>
                                            <td>@Html.DisplayFor(modelItem => item.PriceSale)</td>
                                            <td>@Html.DisplayFor(modelItem => item.Stock)</td>
                                          
                                            <td>@Html.DisplayFor(modelItem => item.Manufacturer)</td>
                                            <td>@Html.DisplayFor(modelItem => item.IsNew)</td>
                                            <td>@Html.DisplayFor(modelItem => item.IsBestSeller)</td>
                                            <td>@Html.DisplayFor(modelItem => item.Star)</td>
                                            <td>
                                                @if (item.IsActive == true)
                                                {
                                                    <span class="badge badge-success"><i class="fa fa-check"></i> Đang bán</span>
                                                }
                                                else
                                                {
                                                    <span class="badge badge-danger"><i class="fa fa-eye-slash"></i> Đã ẩn/Ngừng bán</span>
                                                }
                                            </td>
                                            <td>@Html.DisplayFor(modelItem => item.MaterialType)</td>
                                            <td>@Html.DisplayFor(modelItem => item.IsMaterial)</td>
                                            <td>
                                                <a asp-action="Edit" asp-route-id="@item.ProductId" class="btn btn-primary">Sửa</a>
                                                <a asp-action="Details" asp-route-id="@item.ProductId" class="btn btn-success">Chi tiết</a>
                                                <a asp-action="Delete" asp-route-id="@item.ProductId" class=" btn btn-danger">Xóa</a>
                                            </td>
                                        </tr>
                                    }


                                </tbody>
                            </table>
                        </div>
                        <!-- /.card-body -->
                    </div>
                    <!-- /.card -->
                </div>
            </div>

            <!-- /.row -->
        </div><!-- /.container-fluid -->
    </section>
    <!-- /.content -->
</div>