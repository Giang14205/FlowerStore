@model FlowerShop.Models.Order

@{
    ViewData["Title"] = "Xóa đơn hàng";
    Layout = "~/Areas/Admin/Views/Shared/_Layout.cshtml";
}

<div class="content-wrapper">
    <!-- Header -->
    <section class="content-header">
        <div class="container-fluid">
            <div class="row mb-2">
                <div class="col-sm-6">
                    <h1>Chi tiết đơn hàng</h1>
                </div>
                <div class="col-sm-6">
                    <ol class="breadcrumb float-sm-right">
                        <li class="breadcrumb-item"><a href="/Admin/Home">Home</a></li>
                        <li class="breadcrumb-item active">Chi tiết đơn</li>
                    </ol>
                </div>
            </div>
        </div>
    </section>

    <!-- Main -->
    <section class="content">
        <div class="container-fluid">
            <div class="row">
                <div class="col-md">

                    <div class="card card-danger">
                        

                        <div class="card-body">

                            <div class="form-group">
                                <label>Khách hàng:</label>
                                <p>@Model.User?.FullName</p>
                            </div>

                            <div class="form-group">
                                <label>Địa chỉ:</label>
                                <p>@Model.ShippingAddress</p>
                            </div>

                            <div class="form-group">
                                <label>Mã số đơn:</label>
                                <p>@Model.OrderNumber</p>
                            </div>


                            <div class="form-group">
                                <label>Voucher:</label>
                                <p>@Model.Voucher?.VoucherName</p>
                            </div>

                            <div class="form-group">
                                <label>Tổng tiền:</label>
                                <p>@Model.TotalAmount</p>
                            </div>
                            <div class="form-group">
                                <label>Phí vận chuyển:</label>
                                <p>@Model.ShippingAmount</p>
                            </div>

                            <div class="form-group">
                                <label>Thanh toán:</label>
                                <p>@Model.PayMethod.PayMethodName</p>
                            </div>

                            <div class="form-group">
                                <label>Trạng thái:</label>
                                <p>@Model.OrderStatus.OrderStatusName</p>
                            </div>
                            <div class="form-group">
                                <label>Ngày đặt:</label>
                                <p>@Model.OrderDate</p>
                            </div>


                            
                                <p><a asp-action="Index" class="btn btn-primary">Quay lại</a></p>

                        

                        </div>
                    </div>

                </div>
            </div>
        </div>
    </section>
</div>
