@model FlowerShop.Models.Order

@{
    ViewData["Title"] = "Sửa đơn hàng";
    Layout = "~/Areas/Admin/Views/Shared/_Layout.cshtml";
}

<div class="content-wrapper">
    <section class="content-header">
        <div class="container-fluid">
            <div class="row mb-2">
                <div class="col-sm-6">
                    <h1>Sửa đơn hàng</h1>
                </div>
                <div class="col-sm-6">
                    <ol class="breadcrumb float-sm-right">
                        <li class="breadcrumb-item"><a href="#">Home</a></li>
                        <li class="breadcrumb-item active">Sửa đơn hàng</li>
                    </ol>
                </div>
            </div>
        </div>
    </section>

    <section class="content">
        <div class="container-fluid">
            <div class="row">
                <div class="col-md">
                    <div class="card card-primary">
                        <div class="card-header">
                            <h3 class="card-title">Cập nhật thông tin đơn hàng #@Model.OrderNumber</h3>
                        </div>

                        <form asp-action="Edit">
                            <input type="hidden" asp-for="OrderId" />
                            <div class="card-body">
                                <div asp-validation-summary="ModelOnly" class="text-danger"></div>

                                <div class="form-group">
                                    <label asp-for="UserId" class="control-label">Khách hàng:</label>
                                    <select asp-for="UserId" class="form-control" asp-items="ViewBag.UserId">
                                        <option value="0" selected>--[Tài khoản người đặt]--</option>
                                    </select>
                                </div>

                                <div class="form-group">
                                    <label asp-for="FullName" class="control-label">Người nhận:</label>
                                    <input asp-for="FullName" class="form-control" />
                                    <span asp-validation-for="FullName" class="text-danger"></span>
                                </div>

                                <div class="form-group">
                                    <label asp-for="Phone" class="control-label">Số điện thoại:</label>
                                    <input asp-for="Phone" class="form-control" />
                                    <span asp-validation-for="Phone" class="text-danger"></span>
                                </div>

                                <div class="form-group">
                                    <label asp-for="Address" class="control-label">Địa chỉ:</label>
                                    <input asp-for="Address" class="form-control" />
                                    <span asp-validation-for="Address" class="text-danger"></span>
                                </div>

                                <div class="form-group">
                                    <label asp-for="Note" class="control-label">Ghi chú của khách:</label>
                                    <textarea asp-for="Note" class="form-control" rows="3"></textarea>
                                    <span asp-validation-for="Note" class="text-danger"></span>
                                </div>

                                <div class="form-group">
                                    <label asp-for="OrderNumber" class="control-label">Mã số đơn:</label>
                                    <input asp-for="OrderNumber" class="form-control" readonly />
                                    <span asp-validation-for="OrderNumber" class="text-danger"></span>
                                </div>

                                @* ==================================================================== *@
                                @* 🔥 ĐƯỢC PHÉP SỬA: KHU VỰC PHÂN CHIA 2 LUỒNG SẢN PHẨM HIỂN THỊ *@
                                @* ==================================================================== *@
                                @{
                                    // 1. Lọc lấy các sản phẩm có sẵn gốc của Cửa hàng
                                    var normalItems = Model.OrderItems.Where(x => string.IsNullOrEmpty(x.Note) || !x.Note.StartsWith("Bó tự phối"));

                                    // 2. Gom nhóm đống nguyên liệu hoa lẻ tự phối theo mã thiết kế trước dấu |
                                    var customBouquetGroups = Model.OrderItems.Where(x => x.Note != null && x.Note.StartsWith("Bó tự phối")).GroupBy(x => x.Note.Split('|')[0]);
                                }

                                <div class="form-group">
                                    <label class="control-label">Chi tiết các sản phẩm đặt trong đơn:</label>
                                    <div class="form-control" style="background: #f8f9fa; height: auto; min-height: 38px; padding: 15px;">

                                        @* LUỒNG A: HIỂN THỊ CÁC SẢN PHẨM CÓ SẴN CỦA SHOP *@
                                        @if (normalItems.Any())
                                        {
                                            <div class="mb-3">
                                                <strong class="text-success" style="font-size: 14px;"><i class="fa fa-shopping-bag"></i> Sản phẩm có sẵn từ cửa hàng:</strong>
                                                <ul class="mt-1 mb-0" style="padding-left: 20px;">
                                                    @foreach (var item in normalItems)
                                                    {
                                                        <li class="mb-1">
                                                            <span class="text-bold">@item.Product?.ProductName</span>
                                                            — Số lượng: <span class="badge badge-secondary">@item.Quantity</span>
                                                        </li>
                                                    }
                                                </ul>
                                            </div>
                                        }

                                        @* LUỒNG B: GỘP HIỂN THỊ VÀ LIỆT KÊ THÀNH PHẦN HOA TỰ PHỐI ĐỘC BẢN *@
                                        @if (customBouquetGroups.Any())
                                        {
                                            <div>
                                                <strong class="text-danger" style="font-size: 14px;"><i class="fa fa-magic"></i> Tác phẩm hoa tự thiết kế (Đã gộp cụm):</strong>
                                                @foreach (var bouquet in customBouquetGroups)
                                                {
                                                    string bouquetTitle = bouquet.Key;
                                                    <div class="mt-2 p-3 rounded" style="background-color: #fffafb; border: 1px solid #ffb6c1;">
                                                        <h6 class="text-bold text-danger mb-1">💐 Bó hoa tự phối thiết kế riêng</h6>
                                                        <small class="text-muted d-block mb-2">@bouquetTitle.Replace("Bó tự phối", "Mã thiết kế:")</small>

                                                        <div style="font-size: 12px; color: #666; background: #fff; padding: 8px 12px; border-radius: 4px; border: 1px dashed #ffb6c1;">
                                                            <span class="text-bold text-dark d-block mb-1"><i class="fa fa-leaf"></i> Chi tiết thành phần cắm bó:</span>
                                                            @foreach (var component in bouquet)
                                                            {
                                                                <div>• @component.Product?.ProductName — SL: <span class="badge badge-light border">@component.Quantity</span></div>
                                                            }
                                                            <div class="text-muted text-italic mt-1">• Công cắm thiết kế: 50,000 đ</div>
                                                        </div>
                                                    </div>
                                                }
                                            </div>
                                        }
                                    </div>
                                </div>

                                <div class="form-group mt-2">
                                    <label class="control-label">Hình ảnh trực quan đơn hàng:</label>
                                    <div class="form-control" style="background: #f8f9fa; height: auto; display: flex; gap: 15px; flex-wrap: wrap; padding: 12px;">

                                        @* 1. In ảnh hàng có sẵn gốc *@
                                        @foreach (var item in normalItems)
                                        {
                                            <div class="text-center" style="width: 75px;">
                                                <img src="@item.Product?.ImagePopular" title="@item.Product?.ProductName" style="width: 70px; height: 70px; object-fit: cover; border-radius: 4px; border: 1px solid #ddd;" />
                                                <small class="text-muted d-block text-truncate" style="font-size: 10px;">Hàng sẵn</small>
                                            </div>
                                        }

                                        @* 2. 🔥 BỂ CHUỖI: Hiện bức ảnh tổng thể Canvas sạch sẽ của bó hoa phối thiết kế *@
                                        @foreach (var bouquet in customBouquetGroups)
                                        {
                                            string bouquetRealImage = "/images/custom-bouquet-icon.png";
                                            var firstItem = bouquet.FirstOrDefault();
                                            if (firstItem != null && firstItem.Note != null && firstItem.Note.Contains("|"))
                                            {
                                                var parts = firstItem.Note.Split('|');
                                                if (parts.Length > 1 && !string.IsNullOrEmpty(parts[1]))
                                                {
                                                    bouquetRealImage = parts[1]; // Chuỗi ảnh Base64 thần thánh từ studio
                                                }
                                            }
                                            <div class="text-center" style="width: 85px;">
                                                <img src="@bouquetRealImage" title="Ảnh mẫu bó hoa thiết kế độc bản" style="width: 80px; height: 80px; object-fit: cover; border-radius: 6px; border: 1px solid #ffb6c1; box-shadow: 1px 1px 3px rgba(0,0,0,0.1);" />
                                                <small class="text-danger text-bold d-block" style="font-size: 10px;"><i class="fa fa-paint-brush"></i> Bó tự phối</small>
                                            </div>
                                        }
                                    </div>
                                </div>

                                <div class="form-group">
                                    <label asp-for="VoucherId" class="control-label">Voucher:</label>
                                    <select asp-for="VoucherId" class="form-control" asp-items="ViewBag.VoucherId">
                                        <option value="" selected>--[Chọn voucher]--</option>
                                    </select>
                                </div>

                                <div class="form-group">
                                    <label asp-for="TotalAmount" class="control-label">Tổng tiền:</label>
                                    <input asp-for="TotalAmount" class="form-control" />
                                    <span asp-validation-for="TotalAmount" class="text-danger"></span>
                                </div>

                                <div class="form-group">
                                    <label asp-for="ShippingAmount" class="control-label">Phí vận chuyển:</label>
                                    <input asp-for="ShippingAmount" class="form-control" />
                                    <span asp-validation-for="ShippingAmount" class="text-danger"></span>
                                </div>

                                <div class="form-group">
                                    <label asp-for="PayMethodId" class="control-label">Thanh toán:</label>
                                    <select asp-for="PayMethodId" class="form-control" asp-items="ViewBag.PayMethodId">
                                        <option value="0" selected>--[chọn phương thức]--</option>
                                    </select>
                                </div>

                                <div class="form-group">
                                    <label asp-for="OrderStatusId" class="control-label">Trạng thái xử lý đơn:</label>
                                    <select asp-for="OrderStatusId" class="form-control" asp-items="ViewBag.OrderStatusId">
                                        <option value="0" selected>--[chọn trạng thái]--</option>
                                    </select>
                                </div>

                                <div class="form-group">
                                    <label asp-for="OrderDate" class="control-label">Ngày đặt:</label>
                                    <input asp-for="OrderDate" class="form-control" />
                                    <span asp-validation-for="OrderDate" class="text-danger"></span>
                                </div>

                                <div class="form-group mb-0">
                                    <button type="submit" class="btn btn-primary"><i class="fa fa-save"></i> Cập nhật</button>
                                    <a asp-action="Index" class="btn btn-default float-right">Quay lại</a>
                                </div>
                            </div>
                        </form>
                    </div>
                </div>
            </div>
        </div>
    </section>
</div>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}