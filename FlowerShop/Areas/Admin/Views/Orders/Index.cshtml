@model IEnumerable<FlowerShop.Models.Order>

@{
    ViewData["Title"] = "Index";
    Layout = "~/Areas/Admin/Views/Shared/_Layout.cshtml";
}

<div class="content-wrapper">
    <!-- Content Header (Page header) -->
    <section class="content-header">
        <div class="container-fluid">
            <div class="row mb-2">
                <div class="col-sm-6">
                    <h1>Quản lý đơn hàng </h1>
                </div>
                <div class="col-sm-6">
                    <ol class="breadcrumb float-sm-right">
                        <li class="breadcrumb-item"><a href="#">Home</a></li>
                        <li class="breadcrumb-item active">Simple Tables</li>
                    </ol>
                </div>
            </div>
        </div><!-- /.container-fluid -->
    </section>

    <!-- Main content -->
    <section class="content">
        <div class="container-fluid">

            <!-- /.row -->
            <div class="row">
                <div class="col-12">
                    <div class="card">
                        <div class="card-header">
                            <h3 class="card-title"><a asp-action="Create">Thêm mới</a></h3>

                            <div class="card-tools">
                                <div class="input-group input-group-sm" style="width: 150px;">
                                    <input type="text" name="table_search" class="form-control float-right" placeholder="Search">

                                    <div class="input-group-append">
                                        <button type="submit" class="btn btn-default">
                                            <i class="fas fa-search"></i>
                                        </button>
                                    </div>
                                </div>
                            </div>
                        </div>
                        <!-- /.card-header -->
                        <div class="card-body table-responsive p-0">
                            <table class="table table-hover text-nowrap">
                                <thead>
                                    <tr>
                                        <th>STT:</th>
                                        <th>Khách hàng:</th>
                                        <th>Địa chỉ:</th>
                                        <th>Mã số đơn:</th>
                                        <th>Voucher:</th>
                                        <th>Tổng tiền:</th>
                                        <th>Phí vận chuyển:</th>
                                        <th>Thanh toán :</th>
                                        <th>Trạng thái:</th>
                                        <th>Ngày đặt:</th>


                                    </tr>
                                </thead>
                                <tbody>
                                    @{
                                        int i = 1;
                                    }
                                    @foreach (var item in Model)
                                    {
                                        <tr>
                                            <td>@(i++)</td>
                                            <td>@Html.DisplayFor(modelItem => item.User.FullName)</td>
                                            <td>@Html.DisplayFor(modelItem => item.ShippingAddress)</td>
                                            <td>@Html.DisplayFor(modelItem => item.OrderNumber)</td>
                                            <td>@Html.DisplayFor(modelItem => item.Voucher.VoucherName)</td>
                                            <td>@Html.DisplayFor(modelItem => item.TotalAmount)</td>
                                            <td>@Html.DisplayFor(modelItem => item.ShippingAmount)</td>
                                            <td>@Html.DisplayFor(modelItem => item.PayMethod.PayMethodName)</td>
                                            <td> <span class="badge bg-info"> @item.OrderStatus?.OrderStatusName </span></td>
                                            <td>@Html.DisplayFor(modelItem => item.OrderDate)</td>


                                            <td>
                                                <a asp-action="Edit" asp-route-id="@item.OrderId" class="btn btn-primary">Sửa</a>
                                                <a asp-action="Details" asp-route-id="@item.OrderId" class="btn btn-success">Chi tiết</a>
                                                <a asp-action="Delete" asp-route-id="@item.OrderId" class=" btn btn-danger">Xóa</a>
                                            </td>
                                        </tr>
                                    }


                                </tbody>
                            </table>
                        </div>
                        <!-- /.card-body -->
                    </div>
                    <!-- /.card -->
                </div>
            </div>

            <!-- /.row -->
        </div><!-- /.container-fluid -->
    </section>
    <!-- /.content -->
</div>