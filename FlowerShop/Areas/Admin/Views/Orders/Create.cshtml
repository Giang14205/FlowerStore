@model FlowerShop.Models.Order

@{
    ViewData["Title"] = "Create";
    Layout = "~/Areas/Admin/Views/Shared/_Layout.cshtml";
}

<div class="content-wrapper">
    <section class="content-header">
        <div class="container-fluid">
            <div class="row mb-2">
                <div class="col-sm-6">
                    <h1>Thêm đơn hàng </h1>
                </div>
                <div class="col-sm-6">
                    <ol class="breadcrumb float-sm-right">
                        <li class="breadcrumb-item"><a href="#">Home</a></li>
                        <li class="breadcrumb-item active">General Form</li>
                    </ol>
                </div>
            </div>
        </div>
    </section>

    <section class="content">
        <div class="container-fluid">
            <div class="row">
                <div class="col-md">
                    <div class="card card-primary">
                        <div class="card-header">
                            <h3 class="card-title">Thêm mới đơn hàng </h3>
                        </div>
                        <div asp-validation-summary="All" class="text-danger"></div>
                        <form asp-action="Create">

                            <div class="card-body">
                                <div asp-validation-summary="ModelOnly" class="text-danger"></div>
                                <div class="form-group">
                                    <label asp-for="UserId" class="control-label">Khách hàng:</label>
                                    <select asp-for="UserId" class="form-control" asp-items="ViewBag.UserId">
                                        <option value="0" selected>--[Khách hàng]--</option>
                                    </select>
                                </div>

                                <div class="form-group">
                                    <label asp-for="FullName" class="control-label">Người nhận:</label>
                                    <input asp-for="FullName" class="form-control" />
                                    <span asp-validation-for="FullName" class="text-danger"></span>
                                </div>

                                <div class="form-group">
                                    <label asp-for="Phone" class="control-label">Số điện thoại:</label>
                                    <input asp-for="Phone" class="form-control" />
                                    <span asp-validation-for="Phone" class="text-danger"></span>
                                </div>

                                <div class="form-group">
                                    <label asp-for="Address" class="control-label">Địa chỉ:</label>
                                    <input asp-for="Address" class="form-control" />
                                    <span asp-validation-for="Address" class="text-danger"></span>
                                </div>

                                <div class="form-group">
                                    <label asp-for="Note" class="control-label">Ghi chú:</label>
                                    <textarea asp-for="Note" class="form-control" rows="3"></textarea>
                                    <span asp-validation-for="Note" class="text-danger"></span>
                                </div>
                                <div class="form-group">
                                    <label asp-for="OrderNumber" class="control-label">Mã số đơn:</label>
                                    <input asp-for="OrderNumber" class="form-control" />
                                    <span asp-validation-for="OrderNumber" class="text-danger"></span>
                                </div>
                                <div class="form-group p-3 rounded" style="background-color: #f8f9fa; border: 1px solid #ced4da;">
                                    <label > Chọn sản phẩm cho đơn hàng:</label>

                                    <select id="ProductSelector" name="SelectedProductId" class="form-control mb-3">
                                        <option value="0" data-image="/images/default.png" data-price="0">-- [Bấm vào đây để chọn hoa] --</option>
                                        @if (ViewBag.Products != null)
                                        {
                                            foreach (var prod in ViewBag.Products)
                                            {
                                                <option value="@prod.ProductId" data-image="@prod.ImagePopular" data-price="@prod.PriceSale">
                                                    @prod.ProductName (@prod.ProductPrice.ToString("N0")đ)
                                                </option>
                                            }
                                        }
                                    </select>

                                    <div id="ProductPreviewBox" class="align-items-center p-2 border rounded bg-white" style="display: none; gap: 15px;">
                                        <div>
                                            <img id="PreviewProductImage" src="/images/default.png" style="width: 75px; height: 75px; object-fit: cover; border-radius: 4px; border: 1px solid #ddd;" />
                                        </div>
                                        <div>
                                            <h6 id="PreviewProductName" class="mb-1 font-weight-bold text-dark" style="font-size: 0.95rem;">Tên sản phẩm</h6>
                                            <small class="text-muted">Giá bán: <span id="PreviewProductPrice" class="text-danger font-weight-bold">0</span>đ</small>
                                        </div>
                                    </div>
                                </div>

                                <div class="form-group">
                                    <label asp-for="VoucherId" class="control-label">Voucher:</label>
                                    <select asp-for="VoucherId" class="form-control" asp-items="ViewBag.VoucherId">
                                        <option value="" selected>--[Chọn voucher]--</option>
                                    </select>
                                </div>
                                <div class="form-group">
                                    <label asp-for="TotalAmount" class="control-label">Tổng tiền:</label>
                                    <input asp-for="TotalAmount" class="form-control" />
                                    <span asp-validation-for="TotalAmount" class="text-danger"></span>
                                </div>


                                <div class="form-group">
                                    <label asp-for="ShippingAmount" class="control-label">Phí vận chuyển:</label>
                                    <input asp-for="ShippingAmount" class="form-control" />
                                    <span asp-validation-for="ShippingAmount" class="text-danger"></span>
                                </div>
                                <div class="form-group">
                                    <label asp-for="PayMethodId" class="control-label">Thanh toán:</label>
                                    <select asp-for="PayMethodId" class="form-control" asp-items="ViewBag.PayMethodId">
                                        <option value="0" selected>--[chọn phương thức]--</option>
                                    </select>
                                </div>
                                <div class="form-group">
                                    <label asp-for="OrderStatusId" class="control-label">Trạng thái:</label>
                                    <select asp-for="OrderStatusId" class="form-control" asp-items="ViewBag.OrderStatusId">
                                        <option value="0" selected>--[chọn trạng thái]--</option>
                                    </select>
                                </div>
                                <div class="form-group">
                                    <label asp-for="OrderDate" class="control-label">Ngày đặt:</label>
                                    <input asp-for="OrderDate" class="form-control"
                                           type="datetime-local"
                                           value="@DateTime.Now.ToString("yyyy-MM-ddTHH:mm")"
                                           readonly style="background-color: #e9ecef;" />
                                    <span asp-validation-for="OrderDate" class="text-danger"></span>
                                </div>

                                <div class="form-group">
                                    <input type="submit" value="Thêm mới" class="btn btn-primary" />
                                </div>
                            </div>
                        </form>

                    </div>


                </div>

            </div>
        </div>
    </section>
</div>


@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}