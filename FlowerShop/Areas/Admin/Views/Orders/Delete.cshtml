@model FlowerShop.Models.Order

@{
    ViewData["Title"] = "Xóa đơn hàng";
    Layout = "~/Areas/Admin/Views/Shared/_Layout.cshtml";
}

<div class="content-wrapper">
    <!-- Header -->
    <section class="content-header">
        <div class="container-fluid">
            <div class="row mb-2">
                <div class="col-sm-6">
                    <h1>Xóa đơn hàng</h1>
                </div>
                <div class="col-sm-6">
                    <ol class="breadcrumb float-sm-right">
                        <li class="breadcrumb-item"><a href="/Admin/Home">Home</a></li>
                        <li class="breadcrumb-item active">Xóa đơn</li>
                    </ol>
                </div>
            </div>
        </div>
    </section>

    <!-- Main -->
    <section class="content">
        <div class="container-fluid">
            <div class="row">
                <div class="col-md">

                    <div class="card card-danger">
                        <div class="card-header">
                            <h3 class="card-title">Bạn có chắc chắn muốn xóa đơn hàng này?</h3>
                        </div>

                        <div class="card-body">

                            <div class="form-group">
                                <label>Tài khoản đặt hàng:</label>
                                <p>@Model.User?.FullName</p>
                            </div>

                            <div class="form-group">
                                <label>Người nhận:</label>
                                <p>@Model.FullName</p>
                            </div>

                            <div class="form-group">
                                <label>Số điện thoại:</label>
                                <p>@Model.Phone</p>
                            </div>

                            <div class="form-group">
                                <label>Địa chỉ:</label>
                                <p>@Model.Address</p>
                            </div>

                            <div class="form-group">
                                <label>Ghi chú:</label>
                                <p>@Model.Note</p>
                            </div>

                            <div class="form-group">
                                <label>Mã số đơn:</label>
                                <p>@Model.OrderNumber</p>
                            </div>


                            <div class="form-group">
                                <label>Voucher:</label>
                                <p>@Model.Voucher?.VoucherName</p>
                            </div>

                            <div class="form-group">
                                <label>Tổng tiền:</label>
                                <p>@Model.TotalAmount</p>
                            </div>
                            <div class="form-group">
                                <label>Phí vận chuyển:</label>
                                <p>@Model.ShippingAmount</p>
                            </div>

                            <div class="form-group">
                                <label>Thanh toán:</label>
                                <p>@Model.PayMethod.PayMethodName</p>
                            </div>

                            <div class="form-group">
                                <label>Trạng thái:</label>
                                <p>@Model.OrderStatus.OrderStatusName</p>
                            </div>
                            <div class="form-group">
                                <label>Ngày đặt:</label>
                                <p>@Model.OrderDate</p>
                            </div>


                            <form asp-action="Delete" method="post">
                                <input type="hidden" asp-for="OrderId" />

                                <input type="submit" value="Xóa đơn" class="btn btn-danger" />

                            </form>

                        </div>
                    </div>

                </div>
            </div>
        </div>
    </section>
</div>
