@model FlowerShop.Models.Order

@{
    ViewData["Title"] = "Xóa đơn hàng";
    Layout = "~/Areas/Admin/Views/Shared/_Layout.cshtml";
}

<div class="content-wrapper">
    <section class="content-header">
        <div class="container-fluid">
            <div class="row mb-2">
                <div class="col-sm-6">
                    <h1>Xóa đơn hàng</h1>
                </div>
                <div class="col-sm-6">
                    <ol class="breadcrumb float-sm-right">
                        <li class="breadcrumb-item"><a href="/Admin/Home">Home</a></li>
                        <li class="breadcrumb-item active">Xóa đơn</li>
                    </ol>
                </div>
            </div>
        </div>
    </section>

    <section class="content">
        <div class="container-fluid">
            <div class="row">
                <div class="col-md">

                    <div class="card card-danger">
                        <div class="card-header">
                            <h3 class="card-title text-bold"><i class="fa fa-exclamation-triangle"></i> Bạn có chắc chắn muốn xóa đơn hàng này không má?</h3>
                        </div>

                        <div class="card-body">
                            <div class="form-group mb-2">
                                <label class="text-muted mb-0">Tài khoản đặt hàng:</label>
                                <p class="text-bold">@Model.User?.FullName</p>
                            </div>

                            <div class="form-group mb-2">
                                <label class="text-muted mb-0">Người nhận:</label>
                                <p class="text-bold">@Model.FullName</p>
                            </div>

                            <div class="form-group mb-2">
                                <label class="text-muted mb-0">Số điện thoại:</label>
                                <p class="text-bold">@Model.Phone</p>
                            </div>

                            <div class="form-group mb-2">
                                <label class="text-muted mb-0">Địa chỉ:</label>
                                <p>@Model.Address</p>
                            </div>

                            <div class="form-group mb-2">
                                <label class="text-muted mb-0">Ghi chú:</label>
                                <p class="text-warning">@(string.IsNullOrEmpty(Model.Note) ? "Không có ghi chú" : Model.Note)</p>
                            </div>

                            <div class="form-group mb-3">
                                <label class="text-muted mb-0">Mã số đơn:</label>
                                <p class="text-bold">@Model.OrderNumber</p>
                            </div>

                            @* ==================================================================== *@
                            @* 🔥 KHU VỰC PHÂN CHIA 2 LUỒNG SẢN PHẨM PHẢN ÁNH THỰC TẾ TRONG ĐƠN *@
                            @* ==================================================================== *@
                            @{
                                // 1. Lọc lấy các sản phẩm mua sẵn gốc của shop
                                var normalItems = Model.OrderItems.Where(x => string.IsNullOrEmpty(x.Note) || !x.Note.StartsWith("Bó tự phối"));

                                // 2. Gom nhóm đống nguyên liệu hoa lẻ tự phối theo mã thiết kế trước dấu |
                                var customBouquetGroups = Model.OrderItems.Where(x => x.Note != null && x.Note.StartsWith("Bó tự phối")).GroupBy(x => x.Note.Split('|')[0]);
                            }

                            <div class="form-group">
                                <label class="control-label">Danh sách sản phẩm sẽ bị xóa theo đơn:</label>
                                <div class="form-control" style="background: #f8f9fa; height: auto; min-height: 38px; padding: 12px;">

                                    @* LUỒNG A: SẢN PHẨM SẴN SHOP *@
                                    @if (normalItems.Any())
                                    {
                                        <div class="mb-2">
                                            <strong class="text-success" style="font-size: 13px;"><i class="fa fa-shopping-bag"></i> Sản phẩm có sẵn của cửa hàng:</strong>
                                            <ul class="mt-1 mb-0" style="padding-left: 20px; font-size: 13px;">
                                                @foreach (var item in normalItems)
                                                {
                                                    <li><span class="text-bold">@item.Product?.ProductName</span> (SL: @item.Quantity)</li>
                                                }
                                            </ul>
                                        </div>
                                    }

                                    @* LUỒNG B: SẢN PHẨM HOA TỰ PHỐI THIẾT KẾ ĐÃ GỘP *@
                                    @if (customBouquetGroups.Any())
                                    {
                                        <div>
                                            <strong class="text-danger" style="font-size: 13px;"><i class="fa fa-magic"></i> Bó hoa tự phối thiết kế riêng:</strong>
                                            @foreach (var bouquet in customBouquetGroups)
                                            {
                                                <div class="mt-1 p-2 rounded" style="background-color: #fffafb; border: 1px dashed #ffb6c1; font-size: 13px;">
                                                    <span class="text-bold text-danger">💐 Bó hoa tự thiết kế</span>
                                                    <small class="text-muted d-block">@bouquet.Key.Replace("Bó tự phối", "Mã thiết kế:")</small>
                                                    <small class="text-dark d-block" style="font-size: 11px; padding-left: 5px;">
                                                        Thành phần: @string.Join(", ", bouquet.Select(x => $"{x.Product?.ProductName} x{x.Quantity}"))
                                                    </small>
                                                </div>
                                            }
                                        </div>
                                    }
                                </div>
                            </div>

                            <div class="form-group mt-2">
                                <label class="control-label">Hình ảnh sản phẩm:</label>
                                <div class="form-control" style="background: #f8f9fa; height: auto; display: flex; gap: 12px; flex-wrap: wrap; padding: 10px;">

                                    @* 1. Hiện ảnh sản phẩm mua sẵn gốc của shop *@
                                    @foreach (var item in normalItems)
                                    {
                                        <div class="text-center" style="width: 75px;">
                                            <img src="@item.Product?.ImagePopular" title="@item.Product?.ProductName" style="width: 70px; height: 70px; object-fit: cover; border-radius: 4px; border: 1px solid #ddd;" />
                                            <small class="text-muted d-block text-truncate" style="font-size: 10px;">Hàng sẵn</small>
                                        </div>
                                    }

                                    @* 2. 🔥 BỂ CHUỖI: Hiện bức ảnh tổng thể Canvas siêu sạch của bó hoa phối thiết kế độc bản *@
                                    @foreach (var bouquet in customBouquetGroups)
                                    {
                                        string bouquetRealImage = "/images/custom-bouquet-icon.png";
                                        var firstItem = bouquet.FirstOrDefault();
                                        if (firstItem != null && firstItem.Note != null && firstItem.Note.Contains("|"))
                                        {
                                            var parts = firstItem.Note.Split('|');
                                            if (parts.Length > 1 && !string.IsNullOrEmpty(parts[1]))
                                            {
                                                bouquetRealImage = parts[1]; // Chuỗi ảnh Base64 render từ Studio Canvas
                                            }
                                        }
                                        <div class="text-center" style="width: 85px;">
                                            <img src="@bouquetRealImage" title="Ảnh mẫu bó hoa tự phối" style="width: 80px; height: 80px; object-fit: cover; border-radius: 6px; border: 1px solid #ffb6c1; box-shadow: 1px 1px 3px rgba(0,0,0,0.1);" />
                                            <small class="text-danger text-bold d-block" style="font-size: 10px;"><i class="fa fa-paint-brush"></i> Bó tự phối</small>
                                        </div>
                                    }
                                </div>
                            </div>

                            <div class="form-group mb-2">
                                <label class="text-muted mb-0">Voucher:</label>
                                <p>@(Model.Voucher?.VoucherName ?? "Không áp dụng")</p>
                            </div>

                            <div class="form-group mb-2">
                                <label class="text-muted mb-0">Phí vận chuyển:</label>
                                <p>@Model.ShippingAmount.ToString("#,##0") đ</p>
                            </div>

                            <div class="form-group mb-2">
                                <label class="text-muted mb-0">Tổng tiền hóa đơn:</label>
                                <p class="text-bold text-danger" style="font-size: 16px;">@Model.TotalAmount.ToString("#,##0") đ</p>
                            </div>

                            <div class="form-group mb-2">
                                <label class="text-muted mb-0">Hình thức thanh toán:</label>
                                <p>@Model.PayMethod?.PayMethodName</p>
                            </div>

                            <div class="form-group mb-2">
                                <label class="text-muted mb-0">Trạng thái đơn:</label>
                                <p><span class="badge badge-warning">@Model.OrderStatus?.OrderStatusName</span></p>
                            </div>

                            <div class="form-group mb-3">
                                <label class="text-muted mb-0">Ngày đặt:</label>
                                <p>@Model.OrderDate?.ToString("dd/MM/yyyy HH:mm")</p>
                            </div>

                            <form asp-action="Delete" method="post">
                                <input type="hidden" asp-for="OrderId" />
                                <button type="submit" class="btn btn-danger"><i class="fa fa-trash"></i> Xác nhận xóa đơn</button>
                                <a href="/Admin/Orders" class="btn btn-secondary float-right">Quay lại danh sách</a>
                            </form>

                        </div>
                    </div>

                </div>
            </div>
        </div>
    </section>
</div>