@model IEnumerable<FlowerShop.Models.OrderStatus>

@{
    ViewData["Title"] = "Index";
    Layout = "~/Areas/Admin/Views/Shared/_Layout.cshtml";
}


<div class="content-wrapper">
    <!-- Content Header (Page header) -->
    <section class="content-header">
        <div class="container-fluid">
            <div class="row mb-2">
                <div class="col-sm-6">
                    <h1>Quản lý Trạng Thái Đơn Hàng </h1>
                </div>
                
            </div>
        </div><!-- /.container-fluid -->
    </section>

    <!-- Main content -->
    <section class="content">
        <div class="container-fluid">

            <!-- /.row -->
            <div class="row">
                <div class="col-12">
                    <div class="card">
                        <div class="card-header">
                            <h3 class="card-title"><a asp-action="Create">Thêm mới</a></h3>

                            <div class="card-tools">
                                <form asp-action="Index" method="get">
                                    <div class="input-group input-group-sm" style="width: 250px;">
                                        <input type="text" name="q" value="@ViewContext.HttpContext.Request.Query["q"]"
                                               class="form-control float-right" placeholder="Tìm trạng thái...">

                                        <div class="input-group-append">
                                            <button type="submit" class="btn btn-default">
                                                <i class="fas fa-search"></i>
                                            </button>
                                            @if (!string.IsNullOrEmpty(ViewContext.HttpContext.Request.Query["q"]))
                                            {
                                                <a asp-action="Index" class="btn btn-default" title="Hủy tìm kiếm">
                                                    <i class="fas fa-times"></i>
                                                </a>
                                            }
                                        </div>
                                    </div>
                                </form>
                               
                            </div>
                        </div>
                        <!-- /.card-header -->
                        <div class="card-body table-responsive p-0">
                            <table class="table table-hover text-nowrap">
                                <thead>
                                    <tr>
                                        <th>STT:</th>
                                        <th>Tên Trạng Thái:</th>
                                        <th>Thao Tác:</th>

                                    </tr>
                                </thead>
                                <tbody>
                                    @{
                                        int i = 1;
                                    }
                                    @foreach (var item in Model)
                                    {
                                        <tr>
                                            <td>@(i++)</td>
                                            <td>@Html.DisplayFor(modelItem => item.OrderStatusName)</td>
                                            
                                            <td>
                                                <a asp-action="Edit" asp-route-id="@item.OrderStatusId" class="btn btn-primary">Sửa</a>
                                                <a asp-action="Details" asp-route-id="@item.OrderStatusId" class="btn btn-success">Chi tiết</a>
                                                <a asp-action="Delete" asp-route-id="@item.OrderStatusId" class=" btn btn-danger">Xóa</a>
                                            </td>
                                        </tr>
                                    }


                                </tbody>
                            </table>
                        </div>
                        <!-- /.card-body -->
                    </div>
                    <!-- /.card -->
                </div>
            </div>

            <!-- /.row -->
        </div><!-- /.container-fluid -->
    </section>
    <!-- /.content -->
</div>