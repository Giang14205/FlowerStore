@model FlowerShop.Models.OrderStatus

@{
    ViewData["Title"] = "Details";
    Layout = "~/Areas/Admin/Views/Shared/_Layout.cshtml";
}


<div class="content-wrapper">
    <!-- Content Header (Page header) -->
    <section class="content-header">
        <div class="container-fluid">
            <div class="row mb-2">
                <div class="col-sm-6">
                    <h1>Chi Tiết Trạng Thái</h1>
                </div>
                
            </div>
        </div><!-- /.container-fluid -->
    </section>

    <!-- Main content -->
    <section class="content">
        <div class="container-fluid">
            <div class="row">
                <!-- left column -->
                <div class="col-md">
                    <!-- general form elements -->
                    <div class="card card-primary">
                        <div class="card-header">
                            <h3 class="card-title">Chi Tiết Trạng Thái</h3>
                        </div>
                        <div class="card-body">
                            <div class="form-group">
                                <label for="exempleInputEmail1">Trạng Thái:</label>
                                @Html.DisplayFor(model => model.OrderStatusName)
                            </div>
                            <div class="form-group">
                                <label for="exempleInputPassword1">Đang hoạt động:</label>
                                @Html.DisplayFor(model => model.IsActive)
                            </div>
                            
                        </div>



                    </div>



                </div>


            </div>

        </div>
        <!-- /.row -->
        <!-- /.container-fluid -->

    </section>
    <!-- /.content -->
</div>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }


}

