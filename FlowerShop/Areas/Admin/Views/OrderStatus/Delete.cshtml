@model FlowerShop.Models.OrderStatus

@{
    ViewData["Title"] = "Delete";
    Layout = "~/Areas/Admin/Views/Shared/_Layout.cshtml";
}



<div class="content-wrapper">
    <!-- Content Header (Page header) -->
    <section class="content-header">
        <div class="container-fluid">
            <div class="row mb-2">
                <div class="col-sm-6">
                    <h1>Xóa trạng thái</h1>
                </div>
                
            </div>
        </div><!-- /.container-fluid -->
    </section>

    <!-- Main content -->
    <section class="content">
        <div class="container-fluid">
            <div class="row">
                <!-- left column -->
                <div class="col-md">
                    <!-- general form elements -->
                    <div class="card card-primary">
                        <div class="card-header">
                            <h3 class="card-title">Xóa trạng thái</h3>
                        </div>
                        <div class="card-body">
                            <div class="form-group">
                                <label for="exempleInputEmail1">Trạng thái:</label>
                                @Html.DisplayFor(model => model.OrderStatusName)
                                <div class="form-group">
                                    <label for="exempleInputPassword1">Trạng thái hoạt động:</label>
                                    @Html.DisplayFor(model => model.IsActive)
                                </div>
                                <form asp-action="Delete">
                                    <input type="hidden" asp-for="OrderStatusId" />
                                    <input type="submit" value="Xóa" class="btn btn-danger" />
                                    <a asp-action="Index" class="btn btn-primary">Quay lại</a>
                                </form>
                            </div>
                         
                        </div>



                    </div>



                </div>


            </div>

        </div>
        <!-- /.row -->
        <!-- /.container-fluid -->

    </section>
    <!-- /.content -->
</div>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }


}

