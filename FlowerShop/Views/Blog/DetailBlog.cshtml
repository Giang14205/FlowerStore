			<!-- sidebar -->
			<div class="col-lg-3 col-md-3 col-sm-12 col-xs-12 sidebar">
				<div class="collapse navbar-collapse" id="mysidebar">
					
					<!--  -->
					<ul class="list-group list-2">
						<li class="list-group-item">Bai viet gan day</li>

						@if (blogrecent != null) 
					{
						@foreach(var i in blogrecent)
						{
								string sUrl = $"/blog/{i.Alias}-{i.BlogId}.html";
							<li class="list-group-item list-item-2">
								<div class="col-lg-5 col-md-5 col-sm-12 col-xs-12">
									<a href="@sUrl"><img src="@i.Image" class="img-responsive" alt="img-holiwood"></a>
								</div>
								<div class="col-lg-7 col-md-7 col-sm-12 col-xs-12 title-post">
									<a href="@sUrl"><h1>@i.Title</h1></a>
									<p>@i.CreatedBlog.Value.ToString("dd/MM/yyyy")</p>
								</div>
							</li>
						}
						}

                      
						
					</ul>
