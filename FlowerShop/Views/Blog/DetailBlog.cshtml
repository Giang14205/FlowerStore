@model IEnumerable<Blog>
@{
	ViewData["Title"] = "DetailBlog";
}
@{
	List<Blog> blogrecent = ViewBag.blogrecent;
}

<main>
	<div class="content-search">

		<div class="container container-100">
			<i class="far fa-times-circle" id="close-search"></i>
			<h3 class="text-center">Xin chao, rat vui khi duoc phuc vu ban...</h3>
			<form method="get" action="/Search/Index" role="search" style="position: relative;">
				<input type="text" class="form-control control-search" value="" autocomplete="off" placeholder="Nhap ten hoa can tim..." aria-label="SEARCH" name="q">
				<button class="button_search" type="submit">Tìm kiếm</button>
			</form>
		</div>


	</div>
	<div class="container banner">
		<figure id="banner-figure"><a href="#"><img src="~/img/banner-shop.jpg" class="img-responsive" alt="img-holiwood"></a></figure>
		<div class="text-banner">
			<h1>Bo Suu Tap<br>Tulips </h1>
			<p>SALE DEN 20% </p>
			<a href="#">Mua Ngay</a>
		</div>
	</div>
	<div class="container content">
		<div class="row">
			<div class="col-lg-9 col-md-9 col-sm-12 col-xs-12">
				<form class="form-group">
					<input type="text" name="input-find" placeholder="Enter your search" class="input-lg">
					<button type="submit"><i class="fas fa-search"></i></button>
				</form>
			</div>

			<div class="col-lg-3 col-md-3 col-sm-12 col-xs-12 menu-breadcrumb">
				<ul class="breadcrumb">
					<li><a href="homev3.html">Home</a></li>
					<li><a href="#">Blogs</a></li>
				</ul>
			</div>
			<div class="col-lg-9 col-md-9 col-sm-12 col-xs-12 content-blog">
				@foreach (var item in Model)
				{
					string sUrl = $"/blog/{item.Alias}-{item.BlogId}.html";

					<div class="row blog-item" style="margin-bottom: 30px; border-bottom: 1px solid #eee; padding-bottom: 20px;">

						<div class="col-lg-6 col-md-6 col-sm-6 col-xs-12 product-blog">
							<a href="@sUrl">
								<img src="@item.Image" class="img-responsive" alt="@item.Title" style="width: 100%; object-fit: cover;">
							</a>
						</div>

						<div class="col-lg-6 col-md-6 col-sm-6 col-xs-12 title-blog">
							<h2 style="margin-top: 0;"><a href="@sUrl">@item.Title</a></h2>

							<div class="time-blog" style="margin: 10px 0;">
								<span class="time"><i class="far fa-calendar-alt"></i> <span>(@item.CreatedBlog.Value.ToString("dd/MM/yyyy"))</span></span>
								<span class="time" style="margin-left: 10px;"><i class="far fa-edit"></i> <span>@item.AuthorName</span></span>
							</div>

							<p>@item.Summary</p>

							<a href="@sUrl" class="btn btn-default" style="margin-top: 10px;">Read more</a>
						</div>

					</div>
				}
