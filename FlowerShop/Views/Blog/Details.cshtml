@model Blog
@{
    List<FeedbackCustomer> blogComment = ViewBag.blogComment;
}
<style>
    .form-control-custom {
        border: 1px solid #ccc !important;
        border-radius: 4px !important;
        padding: 10px !important;
        background: #fff !important;
        width: 100%;
        margin-bottom: 5px;
        color: #333 !important;
        font-weight: 600 !important;
    }

        .form-control-custom::placeholder {
            color: #9ca3af !important;
            font-weight: normal !important;
        }

    input[type=number]::-webkit-inner-spin-button,
    input[type=number]::-webkit-outer-spin-button {
        opacity: 1 !important;
    }

    .submit-btn {
        padding: 12px 32px;
        font-weight: 700;
        font-size: 16px;
        border-radius: 6px;
    }

    .blog-comment-item {
        display: flex;
        gap: 15px;
        margin-bottom: 20px;
        padding: 15px;
        background: #f8f9fa;
        border-radius: 10px;
    }

    .blog-comment-img img {
        width: 45px;
        height: 45px;
        border-radius: 50%;
        object-fit: cover;
    }

    .user-meta {
        display: flex;
        justify-content: space-between;
        margin-bottom: 8px;
    }

        .user-meta strong {
            color: #2d3748;
        }

    .user-comment {
        color: #4a5568;
        line-height: 1.5;
    }
</style>

<main>
    <div class="content-search">

        <div class="container container-100">
            <i class="far fa-times-circle" id="close-search"></i>
            <h3 class="text-center">Xin chao, rat vui khi duoc phuc vu ban...</h3>
            <form method="get" action="/Search/Index" role="search" style="position: relative;">
                <input type="text" class="form-control control-search" value="" autocomplete="off" placeholder="Nhap ten hoa can tim..." aria-label="SEARCH" name="q">
                <button class="button_search" type="submit">Tìm kiếm</button>
            </form>
        </div>


    </div>
    <div class="container content">
        <div class="row">

            <div class="col-lg-12 col-md-12 col-sm-12 col-xs-12 content-blog">
                <div class="product-blog">
                    <a href="#"><img src="@Model.Image" class="img-responsive" alt="img-holiwood"></a>
                </div>
                <div class="title-blog">
                    <div class="time-blog">
                        <span class="time"><i class="far fa-calendar-alt"></i><span>(@Model.CreatedBlog.Value.ToString("dd/MM/yyyy"))</span></span>
                        <span class="time"><i class="far fa-edit"></i><span>@Model.AuthorName</span></span>
                    </div>
                    <h2><a href="blog-post.html">@Model.Title</a></h2>

                    <p class="p1">@Model.Content</p>


                </div>
                <div class="posted">
                    <i class="far fa-edit"></i><span>@Model.AuthorName</span><a href="#">Jenstore</a>

                </div>
                
                <div class="article">
                    <div class="blog-comment pt-10">
                        <style>
                            .blog-comment-item {
                                display: flex;
                                gap: 15px;
                                margin-bottom: 20px;
                                padding: 15px;
                                background: #f8f9fa;
                                border-radius: 10px;
                            }

                            .blog-comment-img img {
                                width: 45px;
                                height: 45px;
                                border-radius: 50%;
                                object-fit: cover;
                            }

                            .blog-comment-content {
                                flex: 1;
                            }

                            .user-meta {
                                display: flex;
                                justify-content: space-between;
                                align-items: center;
                                margin-bottom: 8px;
                            }

                                .user-meta strong {
                                    color: #2d3748;
                                }

                            .user-comment {
                                color: #4a5568;
                                line-height: 1.5;
                            }

                            .btn-link.hover-white {
                                color: #4299e1;
                                text-decoration: none;
                            }

                                .btn-link.hover-white:hover {
                                    color: #2b6cb0;
                                }

                            padding: 12px;
                            .d-none.d-md-flex {
                                display: none !important;
                            }
                        </style>

                        <h4 class="heading mb-7">@blogComment.Count() Comments</h4>

                        @foreach (var item in blogComment)
                        {
                            <div class="blog-comment-item mb-8">
                                <div class="blog-comment-img">

                                   

                                        @if (item.AvatarUrl == null)
                                        {
                                            <img src="~/img/avatar.jpg" alt="Avatar" style="width: 50px; height: 50px; object-fit: cover;">
                                        }
                                        else
                                        {
                                            <img src="@item.AvatarUrl" alt="Avatar" style="width: 50px; height: 50px; object-fit: cover;">
                                        }

                                </div>
                                <div class="blog-comment-content">
                                    <div class="user-meta">
                                        <span>
                                            <strong>@item.Ten -</strong> @item.Email
                                            <span class="rating ms-2">
                                                @for (int i = 0; i < item.Star; i++)
                                                {
                                                    <i class="fas fa-star text-warning"></i>
                                                }
                                            </span>
                                        </span>
                                        <a class="btn btn-link hover-white d-none d-md-flex" href="javascript:void(0)">
                                            <i class="fa fa-reply me-2"></i>
                                            Reply
                                        </a>
                                    </div>
                                    <p class="user-comment mb-0">@item.Content</p>

                                </div>
                            </div>
                        }
                    </div>



                    <div id="product-tag" >
                        <p>
                            <style>
                                /* CSS này giúp 2 cột cao bằng nhau */
                                .row-equal-height {
                                    display: flex;
                                    flex-wrap: wrap;
                                }

                                /* Ép khung chứa ảnh cao 100% */
                                .img-container-full {
                                    height: 100%;
                                    display: block;
                                }

                                    /* Ép thẻ a bên trong cao 100% */
                                    .img-container-full a {
                                        height: 100%;
                                        display: block;
                                    }

                                /* QUAN TRỌNG: Ép ảnh cao 100% và dùng object-fit để cắt ảnh đẹp, không bị méo */
                                .img-cover {
                                    width: 100%;
                                    height: 100% !important;
                                    object-fit: cover; /* Ảnh sẽ tự zoom để lấp đầy khung mà không bị méo */
                                    object-position: center;
                                }
                            </style>
                            <div class="message">
                                <div class="container">
                                    <div class="row row-equal-height">

                                        <div class="col-lg-5 col-md-5 col-sm-12 col-xs-12">
                                            <figure id="img-contact" class="img-container-full">
                                                <a href="#">
                                                    <img src="~/img/img-slide-h22.jpg" class="img-responsive img-cover" alt="img-flower">
                                                </a>
                                            </figure>
                                        </div>

                                        <div class="col-lg-7 col-md-7 col-sm-12 col-xs-12 message-contact">
                                            <h1>Danh Gia Bai Viet</h1>
                                            <partial name="_FeedbackBlog" model="new FlowerShop.Models.FeedbackCustomer { BlogId = Model.BlogId }" />
                                        </div>

                                    </div>
                                </div>
                            </div>
                        </p>
                    </div>

                   
                </div>
            </div>

        </div>


</main>