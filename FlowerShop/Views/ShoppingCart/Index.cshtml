@model List<FlowerShop.Models.CartItemVM>

@{
    ViewData["Title"] = "Giỏ hàng của bạn";
}
<main>
    <div class="banner">
        <div class="container">
            <figure id="banner-about"><a href="#"><img src="~/img/banner-about.jpg" class="img-responsive" alt="img-holiwood"></a></figure>
            <div class="title-banner">
                <h1>GIO HANG</h1>
               
            </div>

        </div>

    </div>
    <section class="container py-5">
        <h2 class="text-center mb-4">GIỎ HÀNG CỦA BẠN</h2>

        @if (Model.Count > 0)
        {
            <div class="row">
                <div class="col-lg-12">
                    <div class="table-responsive">
                        <table class="table table-bordered text-center align-middle">
                            <thead class="table-dark">
                                <tr>
                                    <th style="text-align: center !important;">Ảnh</th>
                                    <th style="text-align: center !important;">Sản phẩm</th>
                                    <th style="text-align: center !important;">Giá</th>
                                    <th style="text-align: center !important;">Số lượng</th>
                                    <th style="text-align: center !important;">Thành tiền</th>
                                    <th style="text-align: center !important;">Thao tác</th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var item in Model)
                                {
                                    <tr style="vertical-align: middle !important;">

                                        <td style="width: 15%; vertical-align: middle !important;">
                                            <div class="d-flex justify-content-center align-items-center" style="height: 100%;">
                                                <img src="@item.Image" alt="@item.ProductName" class="img-fluid" style="max-height: 100px;">
                                            </div>
                                        </td>

                                        <td style="vertical-align: middle !important;">
                                            <h5 class="mb-0">@item.ProductName</h5>
                                        </td>

                                        <td style="vertical-align: middle !important;">
                                            @item.Price.ToString("#,##0") đ
                                        </td>

                                        <td style="width: 150px; vertical-align: middle !important;">
                                            <div style="display: inline-flex !important; flex-direction: row !important; align-items: center !important; justify-content: center !important;">

                                                <a href="javascript:void(0)" onclick="updateQuantity(@item.ProductId, -1)"
                                                   style="display: flex !important; align-items: center; justify-content: center; width: 30px !important; height: 30px !important; border: 1px solid #ccc; text-decoration: none; color: #333; background-color: #f0f0f0; font-weight: bold; cursor: pointer;">
                                                    -
                                                </a>

                                                <input type="text" id="quantity-@item.ProductId" value="@item.Quantity" readonly
                                                       style="width: 40px !important; height: 30px !important; border-top: 1px solid #ccc; border-bottom: 1px solid #ccc; border-left: none; border-right: none; text-align: center; padding: 0 !important; margin: 0 !important; background-color: #fff !important; color: #333 !important; outline: none !important;" />

                                                <a href="javascript:void(0)" onclick="updateQuantity(@item.ProductId, 1)"
                                                   style="display: flex !important; align-items: center; justify-content: center; width: 30px !important; height: 30px !important; border: 1px solid #ccc; text-decoration: none; color: #333; background-color: #f0f0f0; font-weight: bold; cursor: pointer;">
                                                    +
                                                </a>

                                            </div>
                                        </td>

                                        <td class="fw-bold text-danger" style="vertical-align: middle !important;" id="total-@item.ProductId">
                                            @item.Total.ToString("#,##0") đ
                                        </td>

                                        <td style="vertical-align: middle !important;">
                                            <a asp-controller="ShoppingCart" asp-action="Remove" asp-route-productId="@item.ProductId"
                                               class="btn btn-danger btn-sm" onclick="return confirm('Bạn có chắc muốn xóa món này?');">
                                                <i class="fa fa-trash"></i> Xóa
                                            </a>
                                        </td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                </div>
            </div>

            <div class="row mt-4 align-items-center">

                <div class="col-md-9 text-start">
                    <a asp-controller="Home1" asp-action="DetailHome1" class="btn btn-secondary btn-lg w-100 mt-2">
                        <i class="fa fa-arrow-left"></i> Tiếp tục mua sắm
                    </a>
                    
                </div>

                <div class="col-md-3 d-flex justify-content-end">
                    <div class="bg-light p-4 rounded border text-end" style="min-width: 350px;">
                        <h3 class="mb-3">Tổng cộng: <span class="text-danger fw-bold">@Model.Sum(x => x.Total).ToString("#,##0") đ</span></h3>
                       
                        <a asp-controller="ShoppingCart" asp-action="Checkout" class="btn btn-success btn-lg w-100 mt-2">
                            Tiến hành Thanh Toán <i class="fa fa-arrow-right"></i>
                        </a>
                    </div>
                </div>
            </div>
        }
        else
        {
            <div class="text-center py-5">
                <img src="https://i.imgur.com/Drj57qu.png" alt="Empty Cart" style="width: 150px; opacity: 0.5">
                <h3 class="mt-3">Giỏ hàng của bạn đang trống</h3>
                <a href="/" class="btn btn-primary mt-3">Quay lại trang chủ</a>
            </div>
        }
    </section>

</main>


<script src="https://code.jquery.com/jquery-3.6.0.min.js"></script>
<script>
    function updateQuantity(productId, change) {
        var currentQty = parseInt($('#quantity-' + productId).val());
        var newQty = currentQty + change;
        if (newQty < 1) return;

        $.ajax({
            url: '/ShoppingCart/UpdateCart',
            type: 'GET',
            data: { productId: productId, quantity: newQty },
            success: function (result) {
                if (result.success) {
                    $('#quantity-' + productId).val(result.quantity);
                    $('#total-' + productId).text(result.itemTotal);
                    $('#cart-total').text(result.cartTotal);
                } else {
                    // Nếu Controller chưa sửa đúng, nó sẽ nhảy vào đây hoặc im lặng
                    console.log("Dữ liệu trả về không đúng format JSON");
                }
            },
            error: function (xhr) {
                console.log(xhr.responseText); // Xem lỗi chi tiết trong Console
                alert("Lỗi kết nối Server!");
            }
        });
    }
</script>